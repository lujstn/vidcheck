#!/bin/bash
# vidcheck - Video quality checker
# Analyzes video files and displays resolution, HDR, and audio quality information

set -euo pipefail

VERSION="1.1.0"

# Colors for output
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m' # No Color

usage() {
    cat << EOF
Usage: vidcheck <file>

Analyzes video files and displays quality information for:
  • Resolution (with quality rating)
  • HDR format (Dolby Vision profiles, HDR10+, HDR10, HLG)
  • Audio format (Atmos, DTS:X, TrueHD, DTS-HD MA, etc.)

Shows all video and audio tracks with ★ indicating the primary/default track.

Formats with ✅⚠️ are high quality but limited on Apple TV + Infuse:
  • Dolby Vision Profile 7 → no Dolby Vision (falls back to HDR10)
  • HDR10+ → no HDR10+ (falls back to HDR10)
  • Dolby Atmos TrueHD → no Atmos (decodes to lossless 7.1)
  • DTS:X → no DTS:X (decodes to lossless 7.1)

Supported formats: .mov, .mp4, .mkv, .avi, .webm, .m4v, .wmv, .flv, .ts, .mts, .m2ts

Options:
  -h, --help     Show this help message
  -v, --version  Show version number
  -j, --json     Output as JSON

Examples:
  vidcheck "Movie Name (2024).mkv"
  vidcheck /path/to/video.mp4
EOF
}

# Check for ffprobe
check_dependencies() {
    if ! command -v ffprobe &> /dev/null; then
        echo "Error: ffprobe not found. Install ffmpeg:" >&2
        echo "  brew install ffmpeg" >&2
        exit 1
    fi
}

# Main analysis function
analyze_video() {
    local file="$1"
    local json_output="${2:-false}"
    
    if [[ ! -f "$file" ]]; then
        echo "Error: File not found: $file" >&2
        exit 1
    fi
    
    # Get all stream info as JSON and parse with Python for reliability
    local parsed_data
    parsed_data=$(ffprobe -v quiet -print_format json -show_streams -show_format "$file" 2>/dev/null | python3 -c "
import sys, json

try:
    data = json.load(sys.stdin)
except:
    print('ERROR:Could not parse video')
    sys.exit(1)

streams = data.get('streams', [])

video_tracks = []
audio_tracks = []

for idx, s in enumerate(streams):
    stream_type = s.get('codec_type')
    
    if stream_type == 'video':
        # Skip image attachments (album art, etc.)
        if s.get('codec_name') in ['mjpeg', 'png', 'bmp', 'gif']:
            continue
        if s.get('disposition', {}).get('attached_pic', 0) == 1:
            continue
            
        width = s.get('width', 0)
        height = s.get('height', 0)
        field_order = s.get('field_order', 'progressive')
        color_transfer = s.get('color_transfer', '')
        color_primaries = s.get('color_primaries', '')
        codec_name = s.get('codec_name', '')
        is_default = s.get('disposition', {}).get('default', 0) == 1
        
        # Check for HDR metadata in side_data
        side_data_str = ''
        dv_profile = ''
        dv_bl_compatibility = ''
        
        for sd in s.get('side_data_list', []):
            side_data_str += json.dumps(sd)
            if sd.get('side_data_type') == 'DOVI configuration record':
                dv_profile = str(sd.get('dv_profile', ''))
                dv_bl_compatibility = str(sd.get('dv_bl_signal_compatibility_id', ''))
            if 'dv_profile' in sd:
                dv_profile = str(sd.get('dv_profile', ''))
            if 'dv_bl_signal_compatibility_id' in sd:
                dv_bl_compatibility = str(sd.get('dv_bl_signal_compatibility_id', ''))
        
        if not dv_profile and 'dv_profile' in s:
            dv_profile = str(s.get('dv_profile', ''))
        if not dv_bl_compatibility and 'dv_bl_signal_compatibility_id' in s:
            dv_bl_compatibility = str(s.get('dv_bl_signal_compatibility_id', ''))
        
        dv_info = f'{dv_profile}:{dv_bl_compatibility}'
        
        # Determine scan type
        scan_type = 'p'
        if field_order in ['tt', 'bb', 'tb', 'bt']:
            scan_type = 'i'
        
        video_tracks.append({
            'index': idx,
            'width': width,
            'height': height,
            'scan': scan_type,
            'codec': codec_name,
            'color_transfer': color_transfer,
            'color_primaries': color_primaries,
            'side_data': side_data_str,
            'dv_info': dv_info,
            'is_default': is_default
        })
    
    elif stream_type == 'audio':
        codec = s.get('codec_name', '')
        channels = s.get('channels', 0)
        channel_layout = s.get('channel_layout', '')
        profile = str(s.get('profile', ''))
        is_default = s.get('disposition', {}).get('default', 0) == 1
        language = s.get('tags', {}).get('language', s.get('tags', {}).get('LANGUAGE', ''))
        title = s.get('tags', {}).get('title', s.get('tags', {}).get('TITLE', ''))
        
        # Check for Atmos
        has_atmos = False
        has_dtsx = False
        
        for sd in s.get('side_data_list', []):
            sd_str = json.dumps(sd).lower()
            if 'atmos' in sd_str or 'joc' in sd_str:
                has_atmos = True
        
        profile_lower = profile.lower()
        if 'atmos' in profile_lower:
            has_atmos = True
        if 'dts:x' in profile_lower or 'dts-x' in profile_lower or 'dtsx' in profile_lower or profile_lower == 'x':
            has_dtsx = True
        
        tags = s.get('tags', {})
        for k, v in tags.items():
            v_lower = str(v).lower()
            if 'atmos' in v_lower:
                has_atmos = True
            if 'dts:x' in v_lower or 'dts-x' in v_lower or 'dtsx' in v_lower:
                has_dtsx = True
        
        codec_long = s.get('codec_long_name', '').lower()
        if 'dts-hd' in codec_long and 'x' in profile_lower:
            has_dtsx = True
        
        audio_tracks.append({
            'index': idx,
            'codec': codec,
            'channels': channels,
            'channel_layout': channel_layout,
            'profile': profile,
            'has_atmos': has_atmos,
            'has_dtsx': has_dtsx,
            'is_default': is_default,
            'language': language,
            'title': title
        })

# Output as structured format
print('VIDEO_TRACKS_START')
for t in video_tracks:
    print(f\"VIDEO:{t['index']}:{t['width']}:{t['height']}:{t['scan']}:{t['codec']}:{t['color_transfer']}:{t['color_primaries']}:{t['dv_info']}:{t['is_default']}:{t['side_data']}\")
print('VIDEO_TRACKS_END')

print('AUDIO_TRACKS_START')
for t in audio_tracks:
    print(f\"AUDIO:{t['index']}:{t['codec']}:{t['channels']}:{t['profile']}:{t['has_atmos']}:{t['has_dtsx']}:{t['is_default']}:{t['language']}:{t['title']}:{t['channel_layout']}\")
print('AUDIO_TRACKS_END')
" 2>/dev/null) || {
        echo "Error: Could not analyze file. Is it a valid video?" >&2
        exit 1
    }
    
    # Check for errors
    if [[ "$parsed_data" == ERROR:* ]]; then
        echo "Error: ${parsed_data#ERROR:}" >&2
        exit 1
    fi
    
    # Parse video tracks
    local video_section=""
    local audio_section=""
    local in_video=false
    local in_audio=false
    
    while IFS= read -r line; do
        if [[ "$line" == "VIDEO_TRACKS_START" ]]; then
            in_video=true
            continue
        elif [[ "$line" == "VIDEO_TRACKS_END" ]]; then
            in_video=false
            continue
        elif [[ "$line" == "AUDIO_TRACKS_START" ]]; then
            in_audio=true
            continue
        elif [[ "$line" == "AUDIO_TRACKS_END" ]]; then
            in_audio=false
            continue
        fi
        
        if [[ "$in_video" == true ]] && [[ "$line" == VIDEO:* ]]; then
            video_section+="$line"$'\n'
        elif [[ "$in_audio" == true ]] && [[ "$line" == AUDIO:* ]]; then
            audio_section+="$line"$'\n'
        fi
    done <<< "$parsed_data"
    
    # Output header
    if [[ "$json_output" != "true" ]]; then
        echo -e "${BOLD}Video Tracks${NC}"
    fi
    
    # Process video tracks
    local video_count=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" != VIDEO:* ]] && continue
        
        # Parse: VIDEO:index:width:height:scan:codec:color_transfer:color_primaries:dv_info:is_default:side_data
        IFS=':' read -r _ idx width height scan codec color_transfer color_primaries dv_profile dv_bl is_default side_data <<< "$line"
        
        local dv_info="${dv_profile}:${dv_bl}"
        
        # Get resolution info
        local res_name icon interlaced
        [[ "$scan" == "i" ]] && interlaced="i" || interlaced="p"
        
        if (( height >= 4320 )); then
            res_name="8K"
            icon="✅"
        elif (( height >= 2160 )); then
            res_name="4K"
            icon="✅"
        elif (( height >= 1440 )); then
            res_name="1440p"
            icon="👍"
        elif (( height >= 1080 )); then
            if [[ "$interlaced" == "i" ]]; then
                res_name="1080i"
                icon="⚠️"
            else
                res_name="1080p"
                icon="👍"
            fi
        elif (( height >= 720 )); then
            res_name="720p"
            icon="⚠️"
        elif (( height >= 480 )); then
            res_name="480p"
            icon="❌"
        else
            res_name="${height}p"
            icon="❌"
        fi
        
        # Get HDR info
        local hdr_info hdr_icon hdr_warning=""
        
        if [[ -n "$dv_profile" ]] && [[ "$dv_profile" != "False" ]]; then
            if [[ "$dv_profile" == "7" ]]; then
                hdr_info="Dolby Vision P7"
                hdr_icon="✅⚠️"
                hdr_warning=" \033[3;90m(no DV on ATV)\033[0m"
            elif [[ "$dv_profile" == "8" ]]; then
                if [[ "$dv_bl" == "1" ]]; then
                    hdr_info="Dolby Vision P8.1"
                elif [[ "$dv_bl" == "2" ]]; then
                    hdr_info="Dolby Vision P8.2"
                elif [[ "$dv_bl" == "4" ]]; then
                    hdr_info="Dolby Vision P8.4"
                else
                    hdr_info="Dolby Vision P8"
                fi
                hdr_icon="✅"
            elif [[ "$dv_profile" == "5" ]]; then
                hdr_info="Dolby Vision P5"
                hdr_icon="✅"
            else
                hdr_info="Dolby Vision P${dv_profile}"
                hdr_icon="✅"
            fi
        elif [[ "$side_data" == *"HDR10+"* ]] || [[ "$side_data" == *"HDR10Plus"* ]] || [[ "$side_data" == *"SMPTE2094"* ]]; then
            hdr_info="HDR10+"
            hdr_icon="✅⚠️"
            hdr_warning=" \033[3;90m(no HDR10+ on ATV)\033[0m"
        elif [[ "$color_transfer" == "smpte2084" ]] && [[ "$color_primaries" == "bt2020" ]]; then
            hdr_info="HDR10"
            hdr_icon="✅"
        elif [[ "$color_transfer" == "arib-std-b67" ]] && [[ "$color_primaries" == "bt2020" ]]; then
            hdr_info="HLG"
            hdr_icon="✅"
        else
            hdr_info="SDR"
            hdr_icon="❌"
        fi
        
        # Format output
        local default_marker=""
        [[ "$is_default" == "True" ]] && default_marker="★ "
        
        if [[ "$json_output" != "true" ]]; then
            printf "  ${DIM}#%s${NC} %s${CYAN}%s${NC} %s ${DIM}(%dx%d)${NC}  %s %s%s\n" \
                "$idx" "$default_marker" "$res_name" "$icon" "$width" "$height" "$hdr_icon" "$hdr_info" "$hdr_warning"
        fi
        
        ((video_count++))
    done <<< "$video_section"
    
    if [[ "$json_output" != "true" ]]; then
        echo ""
        echo -e "${BOLD}Audio Tracks${NC}"
    fi
    
    # Process audio tracks
    local audio_count=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" != AUDIO:* ]] && continue
        
        # Parse: AUDIO:index:codec:channels:profile:has_atmos:has_dtsx:is_default:language:title:channel_layout
        # Need to handle colons in title field
        local rest="${line#AUDIO:}"
        IFS=':' read -r idx codec channels profile has_atmos has_dtsx is_default language <<< "$rest"
        
        # Re-parse to get title (may contain colons)
        local field_count=0
        local title=""
        local channel_layout=""
        IFS=':' read -ra fields <<< "$rest"
        idx="${fields[0]}"
        codec="${fields[1]}"
        channels="${fields[2]}"
        profile="${fields[3]}"
        has_atmos="${fields[4]}"
        has_dtsx="${fields[5]}"
        is_default="${fields[6]}"
        language="${fields[7]}"
        title="${fields[8]}"
        channel_layout="${fields[9]:-}"
        
        # Determine format name and icon
        local format_name icon atv_warning=""
        
        if [[ "$has_atmos" == "True" ]]; then
            if [[ "$codec" == "truehd" ]]; then
                format_name="TrueHD Atmos"
                icon="✅⚠️"
                atv_warning=" \033[3;90m(no Atmos on ATV)\033[0m"
            elif [[ "$codec" == "eac3" ]]; then
                format_name="EAC3 Atmos"
                icon="✅"
            else
                format_name="${codec^^} Atmos"
                icon="✅"
            fi
        elif [[ "$has_dtsx" == "True" ]]; then
            format_name="DTS:X"
            icon="✅⚠️"
            atv_warning=" \033[3;90m(no DTS:X on ATV)\033[0m"
        elif [[ "$codec" == "truehd" ]]; then
            format_name="TrueHD"
            icon="✅"
        elif [[ "$codec" == "dts" ]]; then
            if [[ "$profile" == *"MA"* ]] || [[ "$profile" == *"HD MA"* ]]; then
                format_name="DTS-HD MA"
                icon="✅"
            elif [[ "$profile" == *"HD"* ]]; then
                format_name="DTS-HD"
                icon="✅"
            else
                format_name="DTS"
                icon="👍"
            fi
        elif [[ "$codec" == "eac3" ]]; then
            format_name="EAC3"
            # Surround EAC3 without Atmos gets 👍
            if (( channels >= 6 )); then
                icon="👍"
            else
                icon="👍"
            fi
        elif [[ "$codec" == "ac3" ]]; then
            format_name="AC3"
            icon="👍"
        elif [[ "$codec" == "flac" ]]; then
            format_name="FLAC"
            icon="✅"
        elif [[ "$codec" == "pcm"* ]] || [[ "$codec" == "wav" ]]; then
            format_name="PCM"
            icon="✅"
        elif [[ "$codec" == "aac" ]]; then
            format_name="AAC"
            icon="👍"
        elif [[ "$codec" == "opus" ]]; then
            format_name="Opus"
            icon="👍"
        elif [[ "$codec" == "mp3" ]]; then
            format_name="MP3"
            icon="⚠️"
        else
            format_name="${codec^^}"
            icon="👍"
        fi
        
        # Channel description
        local channel_desc
        if (( channels >= 8 )); then
            channel_desc="7.1"
        elif (( channels >= 6 )); then
            channel_desc="5.1"
        elif (( channels == 2 )); then
            channel_desc="Stereo"
            # Downgrade icon for stereo (unless lossless)
            if [[ "$icon" == "✅" ]] && [[ "$codec" != "flac" ]] && [[ "$codec" != "pcm"* ]] && [[ "$codec" != "truehd" ]]; then
                icon="⚠️"
            elif [[ "$icon" == "👍" ]]; then
                icon="⚠️"
            fi
        elif (( channels == 1 )); then
            channel_desc="Mono"
            icon="❌"
        else
            channel_desc="${channels}ch"
        fi
        
        # Format output
        local default_marker=""
        [[ "$is_default" == "True" ]] && default_marker="★ "
        
        local lang_display=""
        [[ -n "$language" ]] && lang_display=" ${DIM}[${language}]${NC}"
        
        local title_display=""
        [[ -n "$title" ]] && title_display=" ${DIM}\"${title}\"${NC}"
        
        if [[ "$json_output" != "true" ]]; then
            printf "  ${DIM}#%s${NC} %s%s %s ${CYAN}%s${NC}%s%s%s\n" \
                "$idx" "$default_marker" "$icon" "$format_name" "$channel_desc" "$lang_display" "$title_display" "$atv_warning"
        fi
        
        ((audio_count++))
    done <<< "$audio_section"
    
    if [[ "$json_output" != "true" ]] && (( audio_count == 0 )); then
        echo "  ${DIM}No audio tracks found${NC}"
    fi
}

# Parse arguments
main() {
    local json_mode=false
    local file=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -v|--version)
                echo "vidcheck $VERSION"
                exit 0
                ;;
            -j|--json)
                json_mode=true
                shift
                ;;
            -*)
                echo "Unknown option: $1" >&2
                usage >&2
                exit 1
                ;;
            *)
                file="$1"
                shift
                ;;
        esac
    done
    
    if [[ -z "$file" ]]; then
        usage >&2
        exit 1
    fi
    
    check_dependencies
    analyze_video "$file" "$json_mode"
}

main "$@"
